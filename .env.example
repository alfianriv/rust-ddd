# App config lives in config/*.toml. These override it (section + "__" + key).
APP_ENV=development
# APP_DATABASE__URL=postgres://app:app@127.0.0.1:5432/app
# APP_TOKEN__SECRET=   # at least 32 bytes, e.g. `openssl rand -base64 48`; required outside development

# Used only by the migration CLI (`cargo run -p migration -- up`).
DATABASE_URL=postgres://app:app@127.0.0.1:5432/app

RUST_LOG=info
# LOG_FORMAT=json
